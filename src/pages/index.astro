---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Experience from '../components/Experience.astro';
// Proyectos oculto temporalmente: sin repos ni demos reales que enlazar.
// Para volverlo, descomenta el import de arriba y <Projects /> abajo, y
// devuelve la entrada de navegación en src/data/site.ts.
// import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { totalExperience } from '../data/experience';

const years = totalExperience();
---

<BaseLayout>
  <Header />

  <!-- Ambient background, purely decorative. -->
  <div
    class="pointer-events-none fixed inset-0 -z-10 overflow-hidden print:hidden"
    aria-hidden="true"
  >
    <div
      class="bg-[color-mix(in_oklab,var(--accent)_22%,transparent)] absolute -top-32 -left-32 size-[28rem] rounded-full blur-[100px]"
    >
    </div>
    <div
      class="bg-[color-mix(in_oklab,var(--accent)_14%,transparent)] absolute top-[25%] -right-24 size-[22rem] rounded-full blur-[100px]"
    >
    </div>
  </div>

  <main
    id="contenido"
    class="mx-auto grid w-full max-w-6xl gap-10 px-5 pt-28 pb-20 sm:px-8 md:gap-12 lg:grid-cols-5 lg:pt-32"
  >
    <aside class="lg:col-span-2">
      <Sidebar />
    </aside>

    <div class="space-y-12 lg:col-span-3">
      <Experience />
      <!-- <Projects /> -->
      <Stack />
    </div>
  </main>

  <footer class="print-hidden border-t border-[var(--border)]">
    <div
      class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-3 px-5 py-8 text-xs text-[var(--text-faint)] sm:flex-row sm:px-8"
    >
      <p>
        © {new Date().getFullYear()}
        {site.fullName}. Construido con Astro, Tailwind CSS y TypeScript.
      </p>
      <div class="flex items-center gap-1">
        {
          site.socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="me noopener noreferrer"
              class="flex size-8 items-center justify-center rounded-full transition-colors hover:bg-[var(--surface-sunken)] hover:text-[var(--text)]"
              aria-label={s.label}
              title={s.label}
            >
              <Icon name={s.icon} class="text-base" />
            </a>
          ))
        }
        <button
          type="button"
          class="flex size-8 items-center justify-center rounded-full transition-colors hover:bg-[var(--surface-sunken)] hover:text-[var(--text)]"
          onclick="window.print()"
          aria-label="Imprimir o guardar como PDF"
          title="Imprimir o guardar como PDF"
        >
          <Icon name="printer" class="text-base" />
        </button>
      </div>
    </div>
  </footer>

  <div
    class="print-hidden pointer-events-none fixed right-5 bottom-5 z-30 flex items-center gap-2 rounded-full border border-[var(--border)] bg-[color-mix(in_oklab,var(--surface-raised)_85%,transparent)] px-3 py-2 text-xs text-[var(--text-faint)] opacity-0 shadow-lg backdrop-blur-xl transition-opacity duration-300"
    data-hint
  >
    <Icon name="command" class="text-sm" />
    <span>
      <span class="font-medium text-[var(--text-muted)]">{years}+ años</span> construyendo
      software en Lima
    </span>
  </div>
</BaseLayout>

<style>
  /* Reveal sections as they enter the viewport. Purely additive: if the
     IntersectionObserver never fires, everything stays visible. */
  main > div > section {
    animation: reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /* Gentle entrance for the bottom hint, delayed so it never competes
     with the content above it. */
  const hint = document.querySelector<HTMLElement>('[data-hint]');
  if (hint) {
    window.setTimeout(() => {
      hint.style.opacity = '1';
    }, 1200);
  }
</script>
